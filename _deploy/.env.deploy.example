# ============================================
# Wapps · Configuración de deploy a Hostinger
# ============================================
#
# IMPORTANTE: copia este archivo a .env.deploy y completa los
# valores reales. NO commitees .env.deploy a git — contiene
# tu contraseña.
#
#   cp _deploy/.env.deploy.example _deploy/.env.deploy
#   nano _deploy/.env.deploy
#
# Las credenciales SFTP las encuentras en tu panel de Hostinger:
#   hPanel → Hosting → Manage → Files → FTP Accounts
#   (o "SFTP & SSH Access" en planes más recientes)


# ---------- Servidor SFTP ----------
# Host del servidor SFTP. Hostinger normalmente da algo como:
#   - ftp.servisoftware.com  (común en planes con dominio)
#   - 89.117.xxx.xxx         (a veces IP directa)
#   - xxx.hstgr.io           (subdominio interno de Hostinger)
SFTP_HOST="ftp.servisoftware.com"

# Puerto SFTP. Hostinger usa 22 para SFTP (cifrado).
# Si solo tienes FTP plano, usaría 21 — pero eso es inseguro.
SFTP_PORT="22"

# Usuario SFTP. Generalmente es el nombre que aparece en hPanel,
# tipo "u123456789" o un correo, depende del plan.
SFTP_USER="u000000000"

# Contraseña SFTP. La defines tú en hPanel o te la asignan.
SFTP_PASS="cambiar-esta-clave"


# ---------- Ruta remota donde va Wapps ----------
# Es la ruta DESDE el home del usuario SFTP hasta la carpeta
# pública del subdominio wapps.servisoftware.com.
#
# Hostinger suele estructurarlo así:
#   /domains/servisoftware.com/public_html/wapps/    (subdomain virtual)
#   /domains/wapps.servisoftware.com/public_html/    (subdomain dedicado)
#   /home/u000000000/domains/.../public_html/        (con ruta absoluta)
#
# Para descubrir la ruta exacta, conéctate por SFTP con tu
# cliente favorito (FileZilla, Cyberduck) y navega hasta la
# carpeta del subdominio. Copia esa ruta aquí.
REMOTE_PATH="/domains/wapps.servisoftware.com/public_html"
